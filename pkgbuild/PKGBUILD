pkgname=needleeye
pkgver=0.1.0
pkgrel=1
pkgdesc='3D Earth globe and live KML/KMZ situational viewer for Omarchy'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'libzip' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/needleeye "$pkgdir/usr/bin/needleeye"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/needleeye.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/needleeye.svg"
  install -Dm644 "$startdir/needleeye.desktop" "$pkgdir/usr/share/applications/needleeye.desktop"
}
